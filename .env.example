# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for the client signing and payment links and the Stripe webhook. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (use sk_test_… until you're ready)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# Anthropic → console.anthropic.com → API keys. Powers the in-CRM assistant (Ask AI, ⌘J).
ANTHROPIC_API_KEY=

# Optional: Builds (changing the CRM app from inside the CRM).
# Fine-grained token, this repo only: Contents, Issues, Pull requests = Read and write;
# Actions, Deployments, Commit statuses = Read.
GITHUB_TOKEN=
GITHUB_REPO=ny7fdnr79t-bit/JACKRABBIT
# Branch that published builds merge into. Switch to main once the CRM is live from main.
GITHUB_BASE_BRANCH=crm-nextjs
